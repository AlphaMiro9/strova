{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strova",
  "version": "1.0.0",
  "identifier": "app.strova.player",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Strova",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0c0b12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "YouTube & Musik ohne Tracking",
    "longDescription": "Strova – YouTube-Client über Piped oder Invidious, mit eigenem Player, Musik-Bereich, Stimmungen und SponsorBlock.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
