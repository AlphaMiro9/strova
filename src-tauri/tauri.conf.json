{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strova",
  "version": "1.1.0",
  "identifier": "app.strova.player",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Strova",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0c0b12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMzc0REI3NTMxQzI0OTgKUldTWUpCeFR0MDAzNE1GOTJnV0xHcVh1RzVIMlQ1L2dyY0xVOHBQT0dyaHF4eWlHK0pKbk5mZFgK",
      "endpoints": [
        "https://github.com/AlphaMiro9/strova/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Video",
    "publisher": "Strova",
    "homepage": "https://alphamiro9.github.io/strova/",
    "shortDescription": "YouTube & Musik ohne Tracking",
    "longDescription": "Strova – YouTube-Client über Piped oder Invidious, mit eigenem Player, Musik-Bereich, Stimmungen und SponsorBlock.",
    "copyright": "© 2026 Strova · MIT License",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": ["German", "English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "Strova"
      },
      "wix": {
        "language": ["de-DE", "en-US"],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
